{
  "name": "medusa-starter-default",
  "version": "0.0.4",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": "DO NOT USE NPM - USE YARN INSTEAD"
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build": "medusa build && node scripts/post-build.js",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "nodemon",
    "predeploy": "medusa db:migrate --execute-safe-links && node scripts/run-custom-migrations.js",
    "deploy": "medusa start",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "sync:meili": "yarn sync:meili:products && yarn sync:meili:inventory",
    "sync:meili:products": "medusa exec ./src/scripts/qb_sync/core_jobs/force-meili-sync.ts",
    "sync:meili:inventory": "medusa exec ./src/scripts/sync/sync-inventory-meilisearch.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "code-quality": "yarn type-check && yarn lint && yarn format:check",
    "pre-complete": "node scripts/pre-completion-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.974.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googleapis/gmail": "^16.1.1",
    "@medusajs/admin-sdk": "^2.13.0",
    "@medusajs/auth-google": "^2.13.1",
    "@medusajs/cli": "^2.13.1",
    "@medusajs/draft-order": "^2.13.1",
    "@medusajs/file-s3": "^2.13.0",
    "@medusajs/framework": "^2.13.0",
    "@medusajs/icons": "^2.13.0",
    "@medusajs/js-sdk": "^2.13.0",
    "@medusajs/medusa": "2.13.0",
    "@medusajs/notification-sendgrid": "^2.13.1",
    "@medusajs/order": "2.13.0",
    "@medusajs/ui": "^4.1.0",
    "@rokmohar/medusa-plugin-meilisearch": "^1.3.5",
    "@types/pg": "^8.16.0",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.7.2",
    "glob": "^13.0.0",
    "google-auth-library": "^10.6.2",
    "medusa-plugin-auth": "^1.11.1",
    "meilisearch": "^0.55.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "playwright-core": "^1.59.1",
    "resend": "^6.10.0",
    "scrypt-kdf": "^4.0.0",
    "typeorm": "^0.3.16"
  },
  "devDependencies": {
    "@medusajs/test-utils": "^2.13.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/adm-zip": "^0.5.8",
    "@types/glob": "^9.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "adm-zip": "^0.5.17",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "patch-package": "^8.0.1",
    "pg": "^8.17.2",
    "postgres": "^3.4.8",
    "prettier": "^3.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "xlsx": "^0.18.5",
    "yalc": "1.0.0-pre.53"
  }
}
